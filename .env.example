# Copy these into Vercel → Settings → Environment Variables (not into a committed file).

# The passcode you type to unlock the app on each device.
APP_PASSCODE=

# A long random string (32+ characters) that signs the login cookie.
# Changing it logs out every device.
SESSION_SECRET=

# Your Neon Postgres connection string. Vercel adds this automatically when you
# connect a Neon database from the Storage tab (POSTGRES_URL or *_DATABASE_URL also work).
DATABASE_URL=
