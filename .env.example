# Copy these into Vercel → Settings → Environment Variables (not into a committed file).

# The passcode you type to unlock the app on each device.
APP_PASSCODE=

# A long random string (32+ characters) that signs the login cookie.
# Changing it logs out every device.
SESSION_SECRET=

# Your Supabase connection string: Supabase → Connect → "Transaction pooler" (port 6543),
# with your database password filled in. Not the "Direct connection": Vercel can't reach it.
# If you connect Supabase from Vercel's Storage tab instead, it adds POSTGRES_URL automatically
# and you can leave this empty (any *_DATABASE_URL or *_POSTGRES_URL variable also works).
DATABASE_URL=
